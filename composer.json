{
    "name": "bk203/vici-php",
    "description": "Pure-PHP client implementation of the strongSwan VICI protocol to monitor, configure and control the IKE daemon charon.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "vici",
        "strongswan",
        "ipsec",
        "ike",
        "charon",
        "vpn"
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Bk203\\Vici\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bk203\\Vici\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
